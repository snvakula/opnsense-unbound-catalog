# Generated by OPNsense Catalog Sync.
{% set root = 'OPNsense.UnboundCatalog' %}
{% set enabled = namespace(has_catalog=false) %}
{% for catalog in helpers.toList(root ~ '.catalogs.catalog') if catalog is mapping %}
{%     if catalog.enabled == '1' and catalog.name and catalog.transfer_servers and catalog.authoritative_servers %}
{%         set enabled.has_catalog = true %}
{%     endif %}
{% endfor %}
{% set service_enabled = helpers.getNodeByTag(root ~ '.general.enabled') == '1' and enabled.has_catalog %}
{% set level = helpers.getNodeByTag(root ~ '.general.log_level') %}
unbound_catalog_enable="{{ 'YES' if service_enabled else 'NO' }}"
unbound_catalog_log_level="{{ level if level in ('debug', 'info', 'warning', 'error') else 'info' }}"
